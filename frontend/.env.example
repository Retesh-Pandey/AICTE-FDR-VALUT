# AICTE FDR Portal - Frontend Client Environment Configuration
# ==============================================================

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Supabase Auth Configuration (Client-side)
# IMPORTANT: Only the public publishable anon key may be placed here.
# NEVER place the Supabase service-role key in frontend configuration or code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

