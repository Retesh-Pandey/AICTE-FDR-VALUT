# AICTE Smart FDR Lifecycle Management Portal - Environment Configuration
# =========================================================================

# Environment Mode: 'development' | 'testing' | 'production'
# In production, startup validation enforces strict security controls:
# - ENABLE_DEMO_LOGIN must be false
# - ENABLE_SIMULATED_DATE must be false
# - JWT_SECRET must be strong and not use demo defaults
# - DOCUMENT_ENCRYPTION_KEY must be provided for encryption at rest
# - Wildcard CORS origins are forbidden
ENVIRONMENT=development

# Database Configuration
# Local SQLite for development: sqlite:///./fdr_vault.db
# PostgreSQL for production: postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./fdr_vault.db

# Authentication & JWT Configuration
# In production, generate a secure random 32+ character secret:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_32_plus_character_secure_jwt_secret_here
JWT_EXPIRY_HOURS=12

# Document Encryption at Rest (Fernet key)
# Required in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=your_base64_32byte_fernet_key_here

# Security Policies & Access Controls
# Demo login allows instant login for evaluating roles; strictly disabled in production.
ENABLE_DEMO_LOGIN=true

# Allows administrative simulation of system date for testing 30/15/7d maturity thresholds.
# Strictly disabled in production and restricted to Sovereign Admin in dev.
ENABLE_SIMULATED_DATE=true

# Allowed CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Document Intake & Limits
MAX_UPLOAD_MB=10
MAX_OCR_PAGES=10

# Tesseract OCR Executable (for local Windows/Linux when not in system PATH):
# In Docker, Tesseract is pre-installed at /usr/bin/tesseract.
# Windows default: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Diagnostic endpoint to verify OCR status: GET /health/ocr
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

STORAGE_BUCKET=fdr-documents
UPLOAD_DIR=uploads

# Simulated Bank Verification Adapter
# VERIFIER_MODE=mock: uses synthetic MockBankRecord records for testing and demo.
# IMPORTANT: This is simulated data only and NOT actual bank confirmation.
# Never configure real bank credentials here; real connectivity requires an approved banking gateway.
VERIFIER_MODE=mock
REMINDER_DAYS=30,15,7
MATURITY_CHECK_INTERVAL_HOURS=24

# Supabase Integration (Optional - Fallback to Local Auth & DB when demo keys are used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Frontend Environment Variables (for frontend/.env)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

